 "lessons": [
  {
   "id": "geo.lesson.cone-cylinder",
   "section": "shape2",
   "step": 2,
   "grades": [
    "k",
    "g1"
   ],
   "countries": [
    "*"
   ],
   "title": "Solid shapes and flat shapes",
   "animation": {
    "kind": "solid-to-flat",
    "solids": [
     "cone",
     "cylinder"
    ]
   },
   "article": "A cone and a cylinder are solid shapes. Look at them from the side or from below, and you see flat shapes.",
   "lines": [
    {
     "say": "This is a cone.",
     "show": "cone"
    },
    {
     "say": "A cone is a solid shape. You can hold it.",
     "show": "cone"
    },
    {
     "say": "Look at the cone from the side. You see a triangle!",
     "show": "cone-side"
    },
    {
     "say": "Look at the cone from below. You see a circle!",
     "show": "cone-below"
    },
    {
     "say": "This is a cylinder.",
     "show": "cylinder"
    },
    {
     "say": "Look at the cylinder from the side. You see a rectangle!",
     "show": "cylinder-side"
    },
    {
     "say": "Look at the cylinder from the top. You see a circle!",
     "show": "cylinder-top"
    },
    {
     "say": "Solid shapes have flat shapes hiding inside!",
     "show": "all"
    }
   ],
   "together": "geo.view.cone-side"
  },
  {
   "id": "geo.lesson.cube-ball-pyramid",
   "section": "shape2",
   "step": 3,
   "grades": [
    "g1",
    "g2"
   ],
   "countries": [
    "*"
   ],
   "title": "More solid shapes",
   "animation": {
    "kind": "solid-to-flat",
    "solids": [
     "cube",
     "sphere",
     "pyramid"
    ]
   },
   "article": "A cube, a ball and a pyramid are solid shapes. Each one shows a flat shape when you look at it from one side.",
   "lines": [
    {
     "say": "This is a cube.",
     "show": "cube"
    },
    {
     "say": "Look at the cube from the side. You see a square!",
     "show": "cube-side"
    },
    {
     "say": "This is a ball. It is also called a sphere.",
     "show": "sphere"
    },
    {
     "say": "Cut a ball in half. Each cut side is a circle!",
     "show": "sphere-halves"
    },
    {
     "say": "Turn the two halves and join them. They make a ball again!",
     "show": "sphere-join"
    },
    {
     "say": "Look at the ball from any side. You see a circle!",
     "show": "sphere-side"
    },
    {
     "say": "This is a pyramid.",
     "show": "pyramid"
    },
    {
     "say": "Look at the pyramid from the side. You see a triangle!",
     "show": "pyramid-side"
    },
    {
     "say": "Look at the pyramid from below. You see a square!",
     "show": "pyramid-below"
    },
    {
     "say": "Solid shapes have flat shapes hiding inside!",
     "show": "all"
    }
   ],
   "together": "geo.view.cube-face"
  }
 ],
