  "pages": [
    {
      "art": "p01.webp",
      "text": [
        "A little seed named Pip lay in the dirt.",
        "It was dark and still."
      ],
      "alt": "Pip the seed lies in the dark dirt"
    },
    {
      "art": "p02.webp",
      "text": [
        "\"I am so small,\" said Pip.",
        "\"Will I ever grow?\""
      ],
      "alt": "Pip wonders if it will grow"
    },
    {
      "art": "p03.webp",
      "text": [
        "Then the rain came.",
        "Drip, drop, drip!",
        "Pip got a big drink."
      ],
      "alt": "Rain falls on the dirt"
    },
    {
      "art": "p04.webp",
      "text": [
        "Then the sun came out.",
        "The dirt felt warm."
      ],
      "alt": "The sun warms the dirt"
    },
    {
      "art": "p05.webp",
      "text": [
        "Pip pushed roots down.",
        "Pip pushed up, up, up!"
      ],
      "alt": "Pip grows roots and starts to sprout"
    },
    {
      "art": "p06.webp",
      "text": [
        "A green sprout popped out of the dirt.",
        "Pip could see the sky!"
      ],
      "alt": "A green sprout pops out"
    },
    {
      "art": "p07.webp",
      "text": [
        "A little bird sat next to Pip.",
        "\"You are growing!\" she sang.",
        "\"Keep going!\""
      ],
      "alt": "A bird cheers Pip on"
    },
    {
      "art": "p08.webp",
      "text": [
        "Day by day, Pip grew tall.",
        "One morning, a big pink flower opened.",
        "\"I did it!\" said Pip. The End."
      ],
      "alt": "Pip is now a big pink flower"
    }
  ],
